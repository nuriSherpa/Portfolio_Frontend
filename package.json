{
  "name": "portfolio-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "cp .env.local.example .env.local && next dev -H 0.0.0.0 -p 3000",
    "dev:tunnel": "cp .env.tunnel .env.local && next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "build:local": "cp .env.local.example .env.local && next build",
    "build:tunnel": "cp .env.tunnel .env.local && next build",
    "build:prod": "cp .env.production .env.local && next build",
    "start": "next start",
    "start:local": "cp .env.local.example .env.local && next start -H 0.0.0.0 -p 3000",
    "start:tunnel": "cp .env.tunnel .env.local && next start -H 0.0.0.0 -p 3000",
    "start:prod": "cp .env.production .env.local && next start -H 0.0.0.0 -p 3000",
    "lint": "eslint",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@loadable/component": "^5.16.7",
    "@tanstack/react-virtual": "^3.13.18",
    "axios": "^1.13.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.33.0",
    "jose": "^6.2.2",
    "lucide-react": "^0.563.0",
    "motion": "^12.35.1",
    "next": "^16.1.6",
    "prismjs": "^1.30.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^10.0.2",
    "react-loading-skeleton": "^3.5.0",
    "skeleton": "^4.12.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/cookie": "^0.6.0",
    "@types/loadable__component": "^5.13.10",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
